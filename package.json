{
  "name": "poyraz-ui",
  "version": "3.0.0",
  "description": "Soft glass React component system with npm package imports and a shadcn-compatible source registry",
  "author": "Poyraz Avsever",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poyrazavsever/poyraz-ui.git"
  },
  "homepage": "https://ui.poyrazavsever.com",
  "keywords": [
    "ui",
    "components",
    "minimal",
    "react",
    "nextjs",
    "tailwindcss",
    "radix-ui",
    "shadcn",
    "registry",
    "glassmorphism",
    "design-system"
  ],
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.5.1"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./atoms": {
      "import": {
        "types": "./dist/atoms/index.d.ts",
        "default": "./dist/atoms/index.js"
      },
      "require": {
        "types": "./dist/atoms/index.d.cts",
        "default": "./dist/atoms/index.cjs"
      }
    },
    "./molecules": {
      "import": {
        "types": "./dist/molecules/index.d.ts",
        "default": "./dist/molecules/index.js"
      },
      "require": {
        "types": "./dist/molecules/index.d.cts",
        "default": "./dist/molecules/index.cjs"
      }
    },
    "./organisms": {
      "import": {
        "types": "./dist/organisms/index.d.ts",
        "default": "./dist/organisms/index.js"
      },
      "require": {
        "types": "./dist/organisms/index.d.cts",
        "default": "./dist/organisms/index.cjs"
      }
    },
    "./preset.css": "./src/preset.css",
    "./themes": {
      "import": {
        "types": "./dist/themes/index.d.ts",
        "default": "./dist/themes/index.js"
      },
      "require": {
        "types": "./dist/themes/index.d.cts",
        "default": "./dist/themes/index.cjs"
      }
    }
  },
  "bin": {
    "poyraz-ui": "bin/cli.mjs"
  },
  "files": [
    "dist",
    "src/preset.css",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "pnpm theme:check && tsup --tsconfig tsconfig.lib.json && next build",
    "build:lib": "pnpm theme:check && tsup --tsconfig tsconfig.lib.json",
    "dist:check": "node scripts/check-dist-determinism.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:lib && pnpm typecheck:tests",
    "typecheck:app": "tsc --noEmit --project tsconfig.json",
    "typecheck:lib": "tsc --noEmit --project tsconfig.lib.json",
    "typecheck:tests": "tsc --noEmit --project tsconfig.test.json",
    "audit:v2:source": "node scripts/audit-v2-source.mjs",
    "audit:v2:a11y": "node scripts/audit-v2-a11y-static.mjs",
    "audit:v2:build": "node scripts/audit-v2-build-output.mjs",
    "theme:generate": "node scripts/generate-theme-tokens.mjs",
    "theme:check": "node scripts/generate-theme-tokens.mjs --check && node scripts/check-theme-contrast.mjs && node scripts/check-theme-contract.mjs",
    "registry:sync-theme": "node scripts/registry/sync-theme-registry.mjs",
    "registry:sync-phase5": "node scripts/registry/sync-phase5-registry.mjs",
    "registry:sync-phase6": "node scripts/registry/sync-phase6-registry.mjs",
    "registry:sync-phase7": "node scripts/registry/sync-phase7-registry.mjs",
    "registry:sync-phase8": "node scripts/registry/sync-phase8-registry.mjs",
    "docs:sync": "node scripts/sync-docs-registry.mjs && node scripts/sync-components-doc.mjs",
    "evidence:generate": "node scripts/generate-phase15-evidence.mjs",
    "evidence:check": "node scripts/generate-phase15-evidence.mjs --check",
    "registry:build": "pnpm registry:sync-phase5 && pnpm registry:sync-phase6 && pnpm registry:sync-phase7 && pnpm registry:sync-phase8 && pnpm registry:sync-theme && shadcn build && node scripts/registry/normalize-registry-output.mjs && pnpm docs:sync",
    "registry:validate": "node scripts/registry/validate-registry.mjs",
    "registry:check-files": "node scripts/registry/check-registry-files.mjs",
    "registry:check-graph": "node scripts/registry/check-registry-graph.mjs",
    "registry:check": "pnpm registry:validate && pnpm registry:check-files && pnpm registry:check-graph",
    "registry:smoke": "node scripts/registry/test-install-smoke.mjs",
    "registry:consumer-smoke": "node scripts/registry/test-shadcn-consumers.mjs",
    "fixture:prepare": "node scripts/fixtures/prepare-fixtures.mjs",
    "fixture:typecheck": "pnpm fixture:prepare && tsc --noEmit --project fixtures/next/tsconfig.json && tsc --noEmit --project fixtures/vite/tsconfig.json",
    "fixture:build": "pnpm fixture:prepare && next build fixtures/next && vite build fixtures/vite",
    "fixture:clean-install": "node scripts/fixtures/test-clean-install.mjs",
    "migration:audit": "node scripts/migration/audit-v2-imports.mjs",
    "migration:codemod": "node scripts/migration/codemod-v2-imports.mjs",
    "migration:tokens": "node scripts/migration/audit-theme-tokens.mjs",
    "migration:prepare": "node scripts/migration/prepare-fixture.mjs",
    "migration:fixture": "pnpm migration:prepare && tsc --noEmit --project fixtures/migration/tsconfig.v2.json && tsc --noEmit --project fixtures/migration/tsconfig.v3.json && vite build fixtures/migration",
    "migration:check-final": "node scripts/migration/audit-v2-imports.mjs --fail-on-v2 fixtures/migration/src/main.tsx fixtures/migration/src/v3-consumer.tsx && node scripts/migration/audit-theme-tokens.mjs --fail-on-legacy fixtures/migration/src/main.tsx fixtures/migration/src/v3-consumer.tsx fixtures/migration/src/style.css",
    "release:preflight": "node scripts/release/preflight.mjs",
    "release:artifacts": "node scripts/release/build-artifacts.mjs",
    "release:smoke": "node scripts/release/smoke-release.mjs",
    "release:tarball-smoke": "node scripts/release/test-npm-tarball.mjs",
    "release:verify": "node scripts/release/verify.mjs",
    "budget:check": "node scripts/check-quality-budgets.mjs",
    "motion:audit-aliases": "node scripts/audit-motion-aliases.mjs",
    "motion:audit-performance": "node scripts/audit-motion-performance.mjs",
    "test:button": "node scripts/test-button-contract.mjs && node scripts/test-button-fixture.mjs",
    "test:button:browser": "node scripts/test-button-browser-interactions.mjs",
    "test:phase5": "node scripts/test-phase5-contract.mjs && node scripts/test-phase5-fixture.mjs",
    "test:phase6": "node scripts/test-phase6-contract.mjs && node scripts/test-phase6-fixture.mjs",
    "test:phase7": "node scripts/test-phase7-contract.mjs && node scripts/test-phase7-fixture.mjs",
    "test:phase8": "node scripts/test-phase8-contract.mjs && node scripts/test-phase8-fixture.mjs",
    "test:phase9": "node scripts/test-phase9-contract.mjs && node scripts/audit-motion-performance.mjs",
    "test:phase9:browser": "node scripts/test-phase9-browser-interactions.mjs",
    "test:phase10": "node scripts/test-phase10-contract.mjs",
    "test:phase10:browser": "node scripts/test-phase10-browser-interactions.mjs",
    "test:phase12": "node scripts/test-phase12-migration.mjs && pnpm migration:fixture && pnpm migration:check-final",
    "test:phase13": "node scripts/test-phase13-release.mjs",
    "test:phase14": "node scripts/test-phase14-distribution.mjs",
    "test:package-exports": "node scripts/test-package-exports.mjs",
    "pack:dry-run": "npm pack --dry-run --json --ignore-scripts",
    "audit:public-classname": "node scripts/audit-public-classname.mjs",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:a11y": "vitest run --project accessibility",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:browser:visual": "playwright test tests/browser/visual.spec.ts",
    "test:browser:a11y": "playwright test tests/browser/accessibility.spec.ts --project=desktop-light",
    "test:browser:interactions": "playwright test tests/browser/interactions.spec.ts --project=desktop-light",
    "test:browser:contexts": "playwright test tests/browser/contexts.spec.ts",
    "test:performance": "playwright test tests/browser/performance.spec.ts --project=desktop-light",
    "test": "pnpm test:unit && pnpm test:dom && pnpm test:a11y",
    "quality:static": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm registry:check && pnpm evidence:check && pnpm audit:public-classname && pnpm budget:check",
    "quality": "pnpm quality:static && pnpm test && pnpm registry:smoke && pnpm fixture:typecheck && pnpm test:phase12 && pnpm test:phase13 && pnpm test:phase14",
    "start": "next start",
    "prepublishOnly": "pnpm build:lib && pnpm typecheck:lib && pnpm test:package-exports && pnpm pack:dry-run"
  },
  "peerDependencies": {
    "@hookform/resolvers": ">=3",
    "mermaid": ">=11",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7",
    "reactive-switcher": ">=1",
    "tailwindcss": ">=4",
    "zod": ">=3"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "reactive-switcher": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.574.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@hookform/resolvers": "^5.2.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.10",
    "jsdom": "^29.1.1",
    "mermaid": "^11.12.3",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.5",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.71.1",
    "shadcn": "^4.13.0",
    "shiki": "^4.0.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "zod": "^4.3.6"
  }
}
