{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-shell-block",
  "title": "Dashboard Shell Block",
  "author": "Poyraz Avsever",
  "description": "Poyraz Soft Glass Dashboard Shell Block with container-responsive layout and semantic tokens.",
  "dependencies": [
    "lucide-react@^0.574.0"
  ],
  "registryDependencies": [
    "@poyraz/poyraz-utils",
    "@poyraz/poyraz-theme",
    "@poyraz/avatar",
    "@poyraz/badge",
    "@poyraz/button",
    "@poyraz/card",
    "@poyraz/input",
    "@poyraz/sidebar"
  ],
  "files": [
    {
      "path": "registry/poyraz/blocks/phase8/dashboard-shell-block.tsx",
      "content": "import { Bell, Home, LayoutGrid, Search, Settings, Users } from \"lucide-react\";\n\nimport { Avatar, AvatarFallback } from \"@/components/ui/atoms/avatar\";\nimport { Badge } from \"@/components/ui/atoms/badge\";\nimport { Button } from \"@/components/ui/atoms/button\";\nimport { Card } from \"@/components/ui/atoms/card\";\nimport { Input } from \"@/components/ui/atoms/input\";\nimport {\n  Sidebar,\n  SidebarBranding,\n  SidebarContent,\n  SidebarFooter,\n  SidebarGroup,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarMenu,\n  SidebarMenuItem,\n  SidebarUserProfile,\n} from \"@/components/ui/organisms/sidebar\";\n\nconst shellNavigation = [\n  { label: \"Overview\", icon: Home, active: true },\n  { label: \"Projects\", icon: LayoutGrid },\n  { label: \"Team\", icon: Users },\n  { label: \"Settings\", icon: Settings },\n];\n\nfunction DashboardShellBlock({ children }: { children?: React.ReactNode }) {\n  return (\n    <section\n      data-slot=\"dashboard-shell-block\"\n      className=\"@container/shell min-h-[38rem] overflow-hidden rounded-xl border border-glass-border-outer bg-surface-subtle p-2 shadow-sm\"\n    >\n      <div className=\"grid min-h-[37rem] grid-cols-1 overflow-hidden rounded-lg border border-border bg-background @lg/shell:grid-cols-[14rem_minmax(0,1fr)]\">\n        <Sidebar\n          variant=\"inset\"\n          className=\"hidden h-full w-full rounded-none border-0 border-r shadow-none @lg/shell:flex\"\n        >\n          <SidebarHeader>\n            <SidebarBranding title=\"Northstar\" subtitle=\"Product workspace\" />\n          </SidebarHeader>\n          <SidebarContent>\n            <SidebarGroup>\n              <SidebarGroupLabel>Workspace</SidebarGroupLabel>\n              <SidebarMenu>\n                {shellNavigation.map(({ label, icon: Icon, active }) => (\n                  <SidebarMenuItem key={label} active={active} icon={<Icon className=\"size-4\" />}>\n                    {label}\n                  </SidebarMenuItem>\n                ))}\n              </SidebarMenu>\n            </SidebarGroup>\n          </SidebarContent>\n          <SidebarFooter>\n            <SidebarUserProfile name=\"Poyraz Avsever\" role=\"Administrator\" initials=\"PA\" />\n          </SidebarFooter>\n        </Sidebar>\n        <div className=\"min-w-0\">\n          <header className=\"flex min-h-14 items-center gap-2 border-b border-border px-3 @sm/shell:px-5\">\n            <div className=\"relative hidden flex-1 @sm/shell:block\">\n              <Search className=\"absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground\" />\n              <Input\n                aria-label=\"Search workspace\"\n                placeholder=\"Search workspace\"\n                className=\"max-w-sm pl-9\"\n              />\n            </div>\n            <Badge variant=\"success\" className=\"mr-auto @sm/shell:mr-0\">\n              All systems operational\n            </Badge>\n            <Button size=\"icon-sm\" variant=\"ghost\" aria-label=\"Notifications\">\n              <Bell className=\"size-4\" />\n            </Button>\n            <Avatar size=\"sm\">\n              <AvatarFallback>PA</AvatarFallback>\n            </Avatar>\n          </header>\n          <main data-slot=\"dashboard-shell-content\" className=\"min-w-0 p-3 @sm/shell:p-5\">\n            {children ?? (\n              <Card\n                variant=\"soft\"\n                className=\"min-h-72 items-center justify-center p-6 text-center text-sm text-muted-foreground\"\n              >\n                Dashboard content\n              </Card>\n            )}\n          </main>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nexport { DashboardShellBlock, shellNavigation };\n",
      "type": "registry:block",
      "target": "@ui/blocks/phase8/dashboard-shell-block.tsx"
    }
  ],
  "meta": {
    "category": "phase-8-block",
    "phase": "beta",
    "responsive": "container",
    "accessibilityReviewed": true
  },
  "type": "registry:block"
}