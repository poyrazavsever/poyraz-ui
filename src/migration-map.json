  "propMappings": [
    {
      "component": "All",
      "v2": "className",
      "v3": "className",
      "action": "Preserved; re-apply overrides after visual comparison."
    },
    { "component": "All forwardRef components", "v2": "ref", "v3": "ref", "action": "Preserved." },
    {
      "component": "Button",
      "v2": "asChild",
      "v3": "asChild",
      "action": "Preserved; disabled links now use aria-disabled."
    },
    {
      "component": "Button",
      "v2": "loading",
      "v3": "loading",
      "action": "Preserved; V3 keeps an accessible name and blocks interaction."
    },
    {
      "component": "Button",
      "v2": "variant, size",
      "v3": "variant, size, radius, effect, fillDirection, swapTarget",
      "action": "Existing names compile; review changed dimensions and opt into new effects."
    },
    {
      "component": "Card",
      "v2": "variant",
      "v3": "variant, radius",
      "action": "Legacy variants remain; V3 default radius is xl."
    },
    {
      "component": "Badge",
      "v2": "variant",
      "v3": "variant, size, radius",
      "action": "Existing variants remain; root element is now span rather than div."
    },
    {
      "component": "Input/Textarea",
      "v2": "native props",
      "v3": "native props plus size/radius/invalid",
      "action": "Preserved; use aria-invalid for validation state."
    },
    {
      "component": "Dialog/Sheet/Modal",
      "v2": "open, defaultOpen, onOpenChange",
      "v3": "same controlled contract",
      "action": "Preserved; re-test focus return and portal theme inheritance."
    },
    {
      "component": "Select/Tabs/Accordion",
      "v2": "value, defaultValue, onValueChange",
      "v3": "same controlled contract",
      "action": "Preserved; re-test keyboard behavior."
    },
    {
      "component": "Navbar/Sidebar",
      "v2": "layout props",
      "v3": "composable parts plus container-responsive props",
      "action": "Migrate composition manually; codemod only changes safe imports."
    },
    {
      "component": "Theme",
      "v2": "ThemeProvider themes object",
      "v3": "CSS variables on :root/.dark/[data-poyraz-theme]",
      "action": "Remove runtime theme objects after CSS parity is verified."
    }
  ],
  "variantMappings": [
    {
      "component": "Button",
      "v2": "default|secondary|outline|destructive|ghost|link",
      "v3": "same names",
      "action": "Visual treatment and control heights changed; snapshot each use."
    },
    {
      "component": "Button",
      "v2": "size=default (32px)",
      "v3": "size=sm (32px)",
      "action": "Use sm to preserve approximate old height; V3 default is 40px."
    },
    {
      "component": "Button",
      "v2": "size=sm (28px)",
      "v3": "size=xs (28px)",
      "action": "Use xs for approximate parity."
    },
    {
      "component": "Button",
      "v2": "size=lg (36px)",
      "v3": "size=default (40px) or lg (44px)",
      "action": "No exact alias; choose by layout."
    },
    {
      "component": "Card",
      "v2": "default|bordered|elevated|highlight|ghost|interactive",
      "v3": "same names",
      "action": "Compatibility names remain but V3 removes directional hover movement."
    },
    {
      "component": "Badge",
      "v2": "default|secondary|outline|destructive",
      "v3": "same plus glass|info|success|warning",
      "action": "Existing names remain; V3 defaults to full radius."
    },
    {
      "component": "Typography",
      "v2": "legacy visual variants",
      "v3": "semantic typography variants and text effects",
      "action": "Review heading level separately from visual variant."
    }
  ],
  "tokenMappings": [
    { "v2": "--poyraz-background", "v3": "--poyraz-background", "status": "preserved" },
    { "v2": "--poyraz-foreground", "v3": "--poyraz-foreground", "status": "preserved" },
    {
      "v2": "--poyraz-primary*",
      "v3": "--poyraz-primary*",
      "status": "preserved, values redesigned"
    },
    {
      "v2": "--poyraz-secondary*",
      "v3": "--poyraz-secondary*",
      "status": "preserved, semantic surface"
    },
    { "v2": "--poyraz-muted*", "v3": "--poyraz-muted*", "status": "preserved" },
    { "v2": "--poyraz-accent*", "v3": "--poyraz-accent*", "status": "preserved" },
    { "v2": "--poyraz-destructive*", "v3": "--poyraz-destructive*", "status": "preserved" },
    { "v2": "--poyraz-border / --poyraz-border-strong", "v3": "same names", "status": "preserved" },
    { "v2": "--poyraz-input", "v3": "--poyraz-input", "status": "preserved" },
    { "v2": "--poyraz-ring", "v3": "--poyraz-ring", "status": "preserved" },
    {
      "v2": "--poyraz-overlay*",
      "v3": "--poyraz-overlay*",
      "status": "preserved, backdrop policy added"
    },
    {
      "v2": "--poyraz-surface-50/100/200",
      "v3": "same aliases; prefer --poyraz-surface, -subtle, -raised, -elevated",
      "status": "compatibility alias"
    },
    {
      "v2": "--poyraz-info/success/warning*",
      "v3": "same semantic names",
      "status": "preserved, independent status palettes"
    },
    { "v2": "--font-sans", "v3": "--poyraz-font-primary", "status": "Tailwind alias remains" },
    {
      "v2": "--font-secondary",
      "v3": "--poyraz-font-secondary",
      "status": "Tailwind alias remains"
    },
    { "v2": "custom hardcoded glass colors", "v3": "--poyraz-glass-*", "status": "replace" },
    {
      "v2": "custom duration/easing literals",
      "v3": "--poyraz-motion-duration-* / --poyraz-motion-ease-*",
      "status": "replace"
    },
    { "v2": "custom border radius literals", "v3": "--poyraz-radius-*", "status": "replace" }
  ]
}
